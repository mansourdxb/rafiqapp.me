693],["t",[[83,27,1,3],[83,28,0,4],[83,29,0,1]],15.466],["t",[[83,29,2,8],[83,30,0,2]],16.979],["t",[[83,30,3,4],[83,31,0,6]],15.842],["t",[[83,32,0,6],[83,33,0,2]],16.71],["t",[[83,33,3,4],[83,34,0,6]],16.926]],"ayahs":{"83:7":"كـَلَّآ إِنَّ كِتَٰبَ ٱلۡفُجَّارِ لَفِي سِجِّينٖ","83:8":"وَمَآ أَدۡرَىٰكَ مَا سِجِّينٞ","83:9":"كِتَٰبٞ مَّرۡقُومٞ","83:10":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","83:11":"ٱلَّذِينَ يُكَذِّبُونَ بِيَوۡمِ ٱلدِّينِ","83:12":"وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعۡتَدٍ أَثِيمٍ","83:13":"إِذَا تُتۡلَىٰ عَلَيۡهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلۡأَوَّلِينَ","83:14":"كـَلَّاۖ بَلۡۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُواْ يَكۡسِبُونَ","83:15":"كـَلَّآ إِنَّهُمۡ عَن رَّبِّهِمۡ يَوۡمَئِذٖ لَّمَحۡجُوبُونَ","83:16":"ثُمَّ إِنَّهُمۡ لَصَالُواْ ٱلۡجَحِيمِ","83:17":"ثُمَّ يُقَالُ هَٰذَا ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ","83:18":"كـَلَّآ إِنَّ كِتَٰبَ ٱلۡأَبۡرَارِ لَفِي عِلِّيِّينَ","83:19":"وَمَآ أَدۡرَىٰكَ مَا عِلِّيُّونَ","83:20":"كِتَٰبٞ مَّرۡقُومٞ","83:21":"يَشۡهَدُهُ ٱلۡمُقَرَّبُونَ","83:22":"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٍ","83:23":"عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ","83:24":"تَعۡرِفُ فِي وُجُوهِهِمۡ نَضۡرَةَ ٱلنَّعِيمِ","83:25":"يُسۡقَوۡنَ مِن رَّحِيقٖ مَّخۡتُومٍ","83:26":"خِتَٰمُهُۥ مِسۡكٞۚ وَفِي ذَٰلِكَ فَلۡيَتَنَافَسِ ٱلۡمُتَنَٰفِسُونَ","83:27":"وَمِزَاجُهُۥ مِن تَسۡنِيمٍ","83:28":"عَيۡنٗا يَشۡرَبُ بِهَا ٱلۡمُقَرَّبُونَ","83:29":"إِنَّ ٱلَّذِينَ أَجۡرَمُواْ كَانُواْ مِنَ ٱلَّذِينَ ءَامَنُواْ يَضۡحَكُونَ","83:30":"وَإِذَا مَرُّواْ بِهِمۡ يَتَغَامَزُونَ","83:31":"وَإِذَا ٱنقَلَبُوٓاْ إِلَىٰٓ أَهۡلِهِمُ ٱنقَلَبُواْ فَكِهِينَ","83:32":"وَإِذَا رَأَوۡهُمۡ قَالُوٓاْ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ","83:33":"وَمَآ أُرۡسِلُواْ عَلَيۡهِمۡ حَٰفِظِينَ","83:34":"فَٱلۡيَوۡمَ ٱلَّذِينَ ءَامَنُواْ مِنَ ٱلۡكُفَّارِ يَضۡحَكُونَ"},"rub":[]}