":{"78:31":"إِنَّ لِلۡمُتَّقِينَ مَفَازًا","78:32":"حَدَآئِقَ وَأَعۡنَٰبٗا","78:33":"وَكَوَاعِبَ أَتۡرَابٗا","78:34":"وَكَأۡسٗا دِهَاقٗا","78:35":"لَّا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا كِذَّٰبٗا","78:36":"جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَابٗا","78:37":"رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابٗا","78:38":"يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَٰٓئِكَةُ صَفّٗاۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابٗا","78:39":"ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","78:40":"إِنَّآ أَنذَرۡنَٰكُمۡ عَذَابٗا قَرِيبٗا يَوۡمَ يَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ يَدَاهُ وَيَقُولُ ٱلۡكَافِرُ يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا","79:1":"وَٱلنَّٰزِعَٰتِ غَرۡقٗا","79:2":"وَٱلنَّٰشِطَٰتِ نَشۡطٗا","79:3":"وَٱلسَّٰبِحَٰتِ سَبۡحٗا","79:4":"فَٱلسَّٰبِقَٰتِ سَبۡقٗا","79:5":"فَٱلۡمُدَبِّرَٰتِ أَمۡرٗا","79:6":"يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ","79:7":"تَتۡبَعُهَا ٱلرَّادِفَةُ","79:8":"قُلُوبٞ يَوۡمَئِذٖ وَاجِفَةٌ","79:9":"أَبۡصَٰرُهَا خَٰشِعَةٞ","79:10":"يَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِي ٱلۡحَافِرَةِ","79:11":"أَءِذَا كُنَّا عِظَٰمٗا نَّخِرَةٗ","79:12":"قَالُواْ تِلۡكَ إِذٗا كَرَّةٌ خَاسِرَةٞ","79:13":"فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ","79:14":"فَإِذَا هُم بِٱلسَّاهِرَةِ","79:15":"هَلۡ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ"},"rub":[]}