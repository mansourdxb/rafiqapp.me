ُۥ مِن نِّعۡمَةٖ تُجۡزَىٰٓ","92:20":"إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ","92:21":"وَلَسَوۡفَ يَرۡضَىٰ","93:1":"وَٱلضُّحَىٰ","93:2":"وَٱلَّيۡلِ إِذَا سَجَىٰ","93:3":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","93:4":"وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ","93:5":"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ","93:6":"أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ","93:7":"وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ","93:8":"وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ","93:9":"فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ","93:10":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ","93:11":"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ","94:1":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ","94:2":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ","94:3":"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ","94:4":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ","94:5":"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا","94:6":"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا","94:7":"فَإِذَا فَرَغۡتَ فَٱنصَبۡ","94:8":"وَإِلَىٰ رَبِّكَ فَٱرۡغَب"},"rub":[]}