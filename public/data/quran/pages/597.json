ۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِيٓ أَحۡسَنِ تَقۡوِيمٖ","95:5":"ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ","95:6":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونٖ","95:7":"فَمَا يُكَذِّبُكَ بَعۡدُ بِٱلدِّينِ","95:8":"أَلَيۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَٰكِمِينَ","96:1":"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ","96:2":"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ","96:3":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ","96:4":"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ","96:5":"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ","96:6":"كـَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ","96:7":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ","96:8":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ","96:9":"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ","96:10":"عَبۡدًا إِذَا صَلَّىٰٓ","96:11":"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ","96:12":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ","96:13":"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","96:14":"أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ","96:15":"كـَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ","96:16":"نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖ","96:17":"فَلۡيَدۡعُ نَادِيَهُۥ","96:18":"سَنَدۡعُ ٱلزَّبَانِيَةَ","96:19":"كـَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩"},"rub":[]}