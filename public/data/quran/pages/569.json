29,0,4],[70,30,0,1]],18.194],["t",[[70,30,2,10],[70,31,0,2]],20.23],["t",[[70,31,3,7],[70,32,0,4]],19.74],["t",[[70,32,5,5],[70,33,0,4],[70,34,0,4]],20.231],["t",[[70,34,5,5],[70,35,0,4],[70,36,0,4]],20.526],["t",[[70,36,5,5],[70,37,0,5],[70,38,0,3]],17.826],["t",[[70,38,4,8],[70,39,0,5]],17.102]],"ayahs":{"70:11":"يُبَصَّرُونَهُمۡۚ يَوَدُّ ٱلۡمُجۡرِمُ لَوۡ يَفۡتَدِي مِنۡ عَذَابِ يَوۡمِئِذِۭ بِبَنِيهِ","70:12":"وَصَٰحِبَتِهِۦ وَأَخِيهِ","70:13":"وَفَصِيلَتِهِ ٱلَّتِي تُـٔۡوِيهِ","70:14":"وَمَن فِي ٱلۡأَرۡضِ جَمِيعٗا ثُمَّ يُنجِيهِ","70:15":"كـَلَّآۖ إِنَّهَا لَظَىٰ","70:16":"نَزَّاعَةٗ لِّلشَّوَىٰ","70:17":"تَدۡعُواْ مَنۡ أَدۡبَرَ وَتَوَلَّىٰ","70:18":"وَجَمَعَ فَأَوۡعَىٰٓ","70:19":"إِنَّ ٱلۡإِنسَٰنَ خُلِقَ هَلُوعًا","70:20":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعٗا","70:21":"وَإِذَا مَسَّهُ ٱلۡخَيۡرُ مَنُوعًا","70:22":"إِلَّا ٱلۡمُصَلِّينَ","70:23":"ٱلَّذِينَ هُمۡ عَلَىٰ صَلَاتِهِمۡ دَآئِمُونَ","70:24":"وَٱلَّذِينَ فِيٓ أَمۡوَٰلِهِمۡ حَقّٞ مَّعۡلُومٞ","70:25":"لِّلسَّآئِلِ وَٱلۡمَحۡرُومِ","70:26":"وَٱلَّذِينَ يُصَدِّقُونَ بِيَوۡمِ ٱلدِّينِ","70:27":"وَٱلَّذِينَ هُم مِّنۡ عَذَابِ رَبِّهِم مُّشۡفِقُونَ","70:28":"إِنَّ عَذَابَ رَبِّهِمۡ غَيۡرُ مَأۡمُونٖ","70:29":"وَٱلَّذِينَ هُمۡ لِفُرُوجِهِمۡ حَٰفِظُونَ","70:30":"إِلَّا عَلَىٰٓ أَزۡوَٰجِهِمۡ أَوۡ مَا مَلَكَتۡ أَيۡمَٰنُهُمۡ فَإِنَّهُمۡ غَيۡرُ مَلُومِينَ","70:31":"فَمَنِ ٱبۡتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ ٱلۡعَادُونَ","70:32":"وَٱلَّذِينَ هُمۡ لِأَمَٰنَٰتِهِمۡ وَعَهۡدِهِمۡ رَٰعُونَ","70:33":"وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمۡ قَآئِمُونَ","70:34":"وَٱلَّذِينَ هُمۡ عَلَىٰ صَلَاتِهِمۡ يُحَافِظُونَ","70:35":"أُوْلَٰٓئِكَ فِي جَنَّٰتٖ مُّكۡرَمُونَ","70:36":"فَمَالِ ٱلَّذِينَ كَفَرُواْ قِبَلَكَ مُهۡطِعِينَ","70:37":"عَنِ ٱلۡيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ","70:38":"أَيَطۡمَعُ كُلُّ ٱمۡرِيٕٖ مِّنۡهُمۡ أَن يُدۡخَلَ جَنَّةَ نَعِيمٖ","70:39":"كـَلَّآۖ إِنَّا خَلَقۡنَٰهُم مِّمَّا يَعۡلَمُونَ"},"rub":["70:19"]}